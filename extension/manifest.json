{
  "manifest_version": 3,
  "name": "MU Portal Rewrite",
  "version": "0.7.0",
  "permissions": ["webRequest", "storage"],
  "host_permissions": [
    "https://portal.musashino-u.ac.jp/*",
    "https://musashino-u.myopenlms.net/*",
    "https://unipa.m-muscat.musashino-u.ac.jp/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://portal.musashino-u.ac.jp/*"],
      "js": ["dist/portal-react.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://musashino-u.myopenlms.net/*"],
      "js": ["dist/lms-react.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://unipa.m-muscat.musashino-u.ac.jp/uprx/*"],
      "js": ["dist/muscat-react.js"],
      "run_at": "document_start"
    }
  ],
  "background": { "service_worker": "background.js", "type": "module" }
}
